{
  "name": "agent-fleet",
  "version": "0.1.0",
  "description": "MCP server framework for orchestrating external AI CLIs in Claude Code agent teams",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent-fleet": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/vitest/vitest.mjs run",
    "test:watch": "node --experimental-vm-modules node_modules/vitest/vitest.mjs watch",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "fleet.yaml.example"
  ],
  "keywords": ["mcp", "claude", "gemini", "codex", "agent", "ai", "cli"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
